# Amplitude Analytics + Session Replay
# Browser API key. Public by design (it ships in the client bundle). The
# project key is baked in as the default, so set this only to point a given
# environment at a different Amplitude project.
# NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Data region of the Amplitude project. Defaults to US, which is where the
# project above lives. Set to EU only alongside a key from an EU-region
# project — a key/region mismatch is rejected as "Invalid API key".
# NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=EU
# Events and remote config are relayed through /api/insights so content
# blockers do not drop them. Set to "off" to call Amplitude directly.
# NEXT_PUBLIC_AMPLITUDE_PROXY=off

# Compulsary
# NOTION_TOKEN=
# NOTION_BLOG_DATA_SOURCE_ID=


# Alternatively, provide a database ID and the sync script will use its first data source.
# NOTION_BLOG_DATABASE_ID=

# Optional overrides
# NOTION_API_VERSION=2026-03-11
# NOTION_BLOG_OUTPUT_DIR=content/notion
# NOTION_BLOG_TITLE_PROPERTY=Name
# NOTION_BLOG_SLUG_PROPERTY=Slug
# NOTION_BLOG_SUMMARY_PROPERTY=Summary
# NOTION_BLOG_PUBLISHED_AT_PROPERTY=Published At
# NOTION_BLOG_UPDATED_AT_PROPERTY=Updated At
# NOTION_BLOG_AUTHOR_PROPERTY=Author
# NOTION_BLOG_IMAGE_PROPERTY=Image
# NOTION_BLOG_TAGS_PROPERTY=Tags
# NOTION_BLOG_PUBLISHED_PROPERTY=Published
# NOTION_BLOG_STATUS_PROPERTY=Status

# Recommended places map
# NOTION_PLACES_DATA_SOURCE_ID=

# Alternatively, provide a database ID and the app will use its first data source.
# NOTION_PLACES_DATABASE_ID=

# Optional recommended places property overrides
# NOTION_PLACES_NAME_PROPERTY=Name
# NOTION_PLACES_CATEGORY_PROPERTY=Category
# NOTION_PLACES_CITY_PROPERTY=City
# Location text used by code to generate Google Maps links.
# NOTION_PLACES_PLACE_PROPERTY=Location Query
# NOTION_PLACES_COUNTRY_PROPERTY=Country
# NOTION_PLACES_SUMMARY_PROPERTY=Summary
# NOTION_PLACES_TIP_PROPERTY=Tip
# NOTION_PLACES_PUBLISHED_PROPERTY=Published
# NOTION_PLACES_SORT_PROPERTY=Sort
